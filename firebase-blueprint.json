{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A rental room or hostel listing near JKUAT.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string", "enum": ["Bedsitter", "Single Room", "Shared Room", "Hostel"] },
        "distanceToCampus": { "type": "number", "description": "Walking distance in minutes" },
        "location": { "type": "string" },
        "coordinates": { 
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "landlordId": { "type": "string", "description": "Reference to the landlord" },
        "landlordName": { "type": "string" },
        "landlordPhone": { "type": "string" },
        "landlordWhatsApp": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "type", "landlordPhone", "landlordId"]
    },
    "Landlord": {
      "title": "Landlord",
      "description": "A property owner or agent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "isVerified"]
    }
  },
  "firestore": {
    "properties": {
      "schema": "Property",
      "description": "Collection of all rental listings."
    },
    "landlords": {
      "schema": "Landlord",
      "description": "Collection of verified landlords."
    }
  }
}
