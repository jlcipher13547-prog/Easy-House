rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'price', 'type', 'landlordPhone', 'landlordId']) 
        && data.title is string && data.title.size() <= 100
        && data.price is number && data.price >= 0
        && data.type in ['Bedsitter', 'Single Room', 'Shared Room', 'Hostel']
        && data.landlordPhone is string && data.landlordPhone.size() <= 20
        && data.landlordId is string && data.landlordId.size() <= 128
        && (data.get('description', '') is string && data.description.size() <= 2000)
        && (data.get('amenities', []) is list && data.amenities.size() <= 20)
        && (data.get('images', []) is list && data.images.size() <= 10);
    }

    function isValidLandlord(data) {
      return data.keys().hasAll(['name', 'phone', 'isVerified'])
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.isVerified is bool;
    }

    match /properties/{propertyId} {
      allow read: if true; // Public listings
      
      allow create: if isSignedIn()
        && isValidId(propertyId)
        && isValidProperty(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().isVerified == false; // Only admins can verify

      allow update: if isSignedIn()
        && isValidProperty(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && (
          // Action: Edit Listing
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'type', 'amenities', 'images', 'updatedAt']))
          // Action: Verify (Admin only - placeholder check)
          // || (request.auth.token.email == 'admin@patakeja.com')
        );

      allow delete: if isSignedIn(); // Basic MVP protection
    }

    match /landlords/{landlordId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(landlordId) && isValidLandlord(incoming());
      allow update: if isSignedIn() && isValidLandlord(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatarUrl'])
      );
      allow delete: if false; // Admins only (not implemented)
    }
  }
}
